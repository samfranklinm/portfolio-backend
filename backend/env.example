# Required
GEMINI_API_KEY=         # Get a free key at aistudio.google.com
BASE_PERSONA=           # System prompt describing Sam's personality and role

# Optional — resume from a public URL (GitHub Gist, etc.) instead of local file
# Update your resume by editing the Gist; no deploy needed.
# RESUME_URL=https://gist.githubusercontent.com/<user>/<gist_id>/raw/resume.json

# Optional
PORT=5003
NODE_ENV=production
MODEL=gemini-3.5-flash   # model ID from aistudio.google.com
RENDER_EXTERNAL_URL=     # Set automatically by Render
